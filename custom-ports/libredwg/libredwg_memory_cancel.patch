+/* [QuickView/v0.13.4] dwg_read_memory
+ * returns 0 on success.
+ *
+ * Decodes a whole DWG or DXF image from a memory buffer.  Mirrors
+ * dwg_read_file/dxf_read_file minus all stdio: a DWG image ("AC10", ...)
+ * is decoded read-only in place, a DXF image is copied to an internal
+ * 0-terminated scratch buffer exactly like dxf_read_file does.
+ * cancel_check/progress/hook_ctx previously set on *dwg are preserved
+ * across the reset and consulted by the decode loops (see decode.c and
+ * in_dxf.c).  Returns DWG_ERR_CANCELLED when the user hooks abort.
+ */
+EXPORT int
+dwg_read_memory (const unsigned char *restrict buffer, size_t size,
+                 Dwg_Data *restrict dwg)
+{
+  Bit_Chain dat = { 0 };
+  Dwg_Version_Type version;
+  unsigned char *chain = NULL;
+  int is_dxf = 0;
+  int error;
+
+  loglevel = dwg->opts & DWG_OPTS_LOGLEVEL;
+
+  if (!buffer || size < 16)
+    {
+      LOG_ERROR ("Invalid memory buffer (%" PRIuSIZE " bytes)", size)
+      return DWG_ERR_INVALIDDWG;
+    }
+  /* Fail on DXF (same discrimination as dxf_read_file) */
+  if (!memcmp (buffer, "AutoCAD Binary DXF", 18))
+    is_dxf = 2;
+
+  else if (memcmp (buffer, "AC10", 4) && memcmp (buffer, "AC1.", 4)
+           && memcmp (buffer, "AC2.10", 6) && memcmp (buffer, "MC0.0", 5))
+    is_dxf = 1;
+
+  version = dwg->header.version;
+
+  /* Preserve the user hooks across the reset */
+  {
+    int (*cancel_check) (void *) = dwg->cancel_check;
+    void (*progress) (void *, size_t, size_t) = dwg->progress;
+    void *hook_ctx = dwg->hook_ctx;
+    memset (dwg, 0, sizeof (Dwg_Data));
+    dwg->opts = loglevel;
+    dwg->header.version = version;
+    dwg->cancel_check = cancel_check;
+    dwg->progress = progress;
+    dwg->hook_ctx = hook_ctx;
+  }
+
+  if (is_dxf)
+    {
+      if (size < 31)
+        {
+          LOG_ERROR ("Buffer too small, %" PRIuSIZE " byte.\n", size)
+          return DWG_ERR_IOERROR;
+        }
+      chain = (unsigned char *)calloc (1, size + 2);
+      if (!chain)
+        {
+          LOG_ERROR ("Not enough memory.\n");
+          return DWG_ERR_OUTOFMEM;
+        }
+      memcpy (chain, buffer, size);
+      // properly end the buffer for strtol()/... readers
+      if (chain[size - 1] != '\n')
+        {
+          chain[size] = '\n';
+          dat.size = size + 1;
+        }
+      else
+        dat.size = size;
+      chain[size] = '\0';
+      dat.chain = chain;
+    }
+  else
+    {
+      /* decoded read-only in place, no copy */
+      dat.chain = (unsigned char *)buffer;
+      dat.size = size;
+    }
+  dat.byte = 0;
+  dat.bit = 0;
+  dat.opts = dwg->opts;
+
+  if (is_dxf)
+    {
+      dat.from_version = dwg->header.from_version;
+      dat.version = dwg->header.version;
+      if (is_dxf == 2)
+        {
+          dat.byte = 22;
+          error = dwg_read_dxfb (&dat, dwg);
+        }
+      else
+        error = dwg_read_dxf (&dat, dwg);
+      dwg->opts |= (DWG_OPTS_INDXF | loglevel);
+      free (chain);
+      chain = NULL;
+      dat.chain = NULL;
+      dat.size = 0;
+    }
+  else
+    error = dwg_decode (&dat, dwg);
+
+  if (error >= DWG_ERR_CRITICAL)
+    {
+      LOG_ERROR ("Failed to decode memory buffer: 0x%x\n", error)
+      return error;
+    }
+
+  return error;
+}
